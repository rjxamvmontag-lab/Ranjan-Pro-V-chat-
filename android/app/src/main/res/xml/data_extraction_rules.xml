<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include user preferences in cloud backup -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude temporary and cache files using valid Android storage domains -->
        <exclude domain="root" path="cache"/>
        <exclude domain="file" path="cache"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include user preferences during device-to-device migration -->
        <include domain="sharedpref" path="."/>
        <!-- Exclude temporary and cache files using valid Android storage domains -->
        <exclude domain="root" path="cache"/>
        <exclude domain="file" path="cache"/>
    </device-transfer>
</data-extraction-rules>
